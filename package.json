{
  "name": "arecanut-intelligence",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": "^22.18.0 || >=24.0.0"
  },
  "workspaces": [
    "frontend",
    "api",
    "video"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,frontend -c green,blue \"npm:dev:api\" \"npm:dev:frontend\"",
    "dev:api": "npm --workspace api run dev",
    "dev:frontend": "npm --workspace frontend run dev",
    "db:migrate:local": "npm --workspace api run db:migrate:local",
    "build": "npm --workspace frontend run build && npm --workspace api run typecheck",
    "test": "npm --workspace api run test && npm run test:frontend",
    "test:frontend": "vitest run --config api/vitest.config.ts frontend/src/pages/product-experience.test.tsx",
    "backfill:monthly": "node scripts/backfill-monthly.mjs",
    "refresh:intelligence": "node scripts/refresh-intelligence.mjs",
    "evaluate:forecasts": "node scripts/evaluate-forecasts.mjs",
    "db:backup": "node scripts/d1-backup.mjs",
    "db:restore-check": "node scripts/d1-restore-check.mjs",
    "db:prepare-import": "node --no-warnings scripts/d1-prepare-import.mjs",
    "retention:temp": "python3 data-platform/ingestion/retention.py",
    "video": "npm --workspace video run studio",
    "video:gif": "npm --workspace video run gif",
    "video:render": "npm --workspace video run render",
    "video:daily": "npm --workspace video run daily",
    "story:daily": "npm --workspace video run story",
    "daily:publish": "npm --workspace video run publish:daily",
    "daily:check": "npm --workspace video run publish:check"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "pdfjs-dist": "^6.5.438"
  }
}
