# Frontend points to the local Worker API by default.
VITE_API_BASE_URL=http://127.0.0.1:8787/api/v1
# Public address of the site, used in the sitemap and link previews.
# Defaults to https://adikenaadi.com; set it when the site moves to another domain.
VITE_SITE_URL=
# Cloudflare Web Analytics site token (Cloudflare dashboard → Analytics & Logs → Web Analytics → Add a site).
# Public by design; leave empty to send no analytics. Production builds read it from the repository variable.
VITE_CF_ANALYTICS_TOKEN=

# Configure these only when using the data.gov.in AGMARKNET resource.
# See docs/AGMARKNET_DAILY_CONNECTOR.md. Never commit a real key.
DATA_GOV_IN_API_KEY=
# Generic connector (fetch_api.py). The daily connector (run_daily.py) uses
# AGMARKNET_DAILY_RESOURCE_ID, then this value, then the verified daily
# resource 9ef84268-d588-465a-a308-a864a43d0070.
AGMARKNET_RESOURCE_ID=
AGMARKNET_DAILY_RESOURCE_ID=
AGMARKNET_API_BASE_URL=https://api.data.gov.in/resource
# The daily resource publishes no unit field. Set Rs./Quintal only after
# confirming the unit; the daily connector refuses to run without it.
AGMARKNET_PRICE_UNIT=
# Daily connector persistence target (not needed for --dry-run).
ANI_API_URL=http://127.0.0.1:8787/api/v1
INGESTION_TOKEN=
# Python document ingester (data-platform/documents); must equal ADMIN_TOKEN in api/.dev.vars.
ANI_ADMIN_TOKEN=
# Optional tuning: AGMARKNET_PAGE_SIZE, AGMARKNET_MAX_PAGES,
# AGMARKNET_MAX_RETRIES, AGMARKNET_TIMEOUT_SECONDS,
# AGMARKNET_BACKOFF_SECONDS, AGMARKNET_PAGE_DELAY_SECONDS.

# Forecasting engine (data-platform/forecasting, see docs/FORECASTING.md).
# Optional: explicit local D1 sqlite path (auto-discovered otherwise),
# MLflow tracking URI, and Chronos checkpoint id (pinned revision in config.py).
ANI_D1_SQLITE=
ANI_MLFLOW_TRACKING_URI=
ANI_CHRONOS_MODEL=

# Worker secrets belong in api/.dev.vars, not this frontend environment.
# Copy api/.dev.vars.example separately. Never prefix a secret with VITE_:
# VITE_ variables are public and embedded in the frontend build.
